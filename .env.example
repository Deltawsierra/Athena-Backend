# Copy to .env and fill in. Nothing here has a default in source any more:
# a Django secret key and a live mail password used to be committed as
# fallbacks in config/settings.py.

# Required. Signs sessions and every JWT this service issues.
DJANGO_SECRET_KEY=ce_op_08e7410ebad129b36c0b9a479d3732d88a1b91082f02e8efe20817cf62ba3505

# Off unless you say otherwise.
DJANGO_DEBUG=0

# Comma separated. Required once DEBUG is off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=

# The scanning engine.
CYBERENGINE_URL=http://127.0.0.1:8001
CYBERENGINE_OPERATOR_KEY=

# Assurance commercial spine — encrypts per-tenant connector / posture
# credentials at rest (assurance.crypto). Absent by default and deliberately so:
# with no key, no credential can be stored, so every connector and posture
# binding stays inert. A Fernet key (comma-separated list enables rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSURANCE_CREDENTIAL_KEY=
# Kill switch for the automated-dispatch signal (default on, but a no-op unless a
# deployment has an admin-enabled dispatch policy and connector bindings).
ASSURANCE_AUTO_DISPATCH_ENABLED=1

# Outbound mail. Rotate any password that was ever committed.
EMAIL_HOST_USER=info@mythosaisecurity.com
EMAIL_HOST_PASSWORD=Cyb3r$3cur1ty&

# The defender gateway.
# Monitor mode logs what would have been blocked and blocks nothing. This was
# hardcoded in settings.py with no override, so the enforcement path could not
# be turned on without editing source. Set to 0 to enforce.
DEFENDER_MONITOR_ONLY=1
DEFENDER_TIMEOUT_SECONDS=0.5
# Proxies in front of this service that append to X-Forwarded-For. Leave at 0
# unless you have one: the header is otherwise attacker controlled.
# Number of proxies in front of this service that append to X-Forwarded-For.
# Zero means the header is not trusted at all. It also sets DRF's NUM_PROXIES,
# so the throttles and the audit log agree on who the caller is; leaving them
# out of step let a rotating header defeat the rate limit on the token
# endpoint entirely.
DEFENDER_TRUSTED_PROXY_COUNT=0
