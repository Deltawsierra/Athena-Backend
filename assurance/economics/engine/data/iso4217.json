    "standard": "ISO 4217, Codes for the representation of currencies",
    "maintained_by": "SIX Financial Information AG, the ISO 4217 Maintenance Agency",
    "lists": {
      "current": "List One: current currency and funds code list (active entries, and every entry's minor unit)",
      "historic": "List Three: historic denominations (the retired entries)"
    },
    "published_at": "https://www.six-group.com/en/products-services/financial-information/data-standards.html",
    "transcribed_on": "2026-10-08",
    "how_made": "Transcribed, not generated from the published files: the download of List One and List Three from the Maintenance Agency's site was refused by the build environment's network policy on 2026-10-08. The active codes and their names were checked against Debian iso-codes 4.16.0 (iso_4217.json), which is built from List One, with the changes listed under after_cross_check applied by hand. Minor units are List One's minor-unit column; an entry whose minor unit List One gives as N.A. (precious metals, bond-market units, the SDR, the Sucre, the ADB unit, and the test and no-currency codes) has null. The retired entries are a selection from List Three: the twelve currencies the euro replaced in 2002 and those of every later adopter, and the redenominations whose successor is a single active code.",
    "cross_checks": [
      "Active codes and names: Debian iso-codes 4.16.0 (iso_4217.json), built from List One.",
      "Minor units of every entry: OpenJDK 21.0.10 (2026-01-20) java.util.Currency.getDefaultFractionDigits, which follows ISO 4217 including historic codes. All agree except UYW, which OpenJDK does not carry (List One gives 4, kept), and ROL, transcribed as 2 and corrected to OpenJDK's 0. N.A. entries are -1 there and null here.",
      "The changes under after_cross_check: OpenJDK 21.0.10's country table gives HR and BG the EUR, CW and SX the XCG, and ZW the ZWG."
    ],
    "after_cross_check": [
      "HRK retired, successor EUR (Croatia adopted the euro on 2023-01-01)",
      "BGN retired, successor EUR (Bulgaria adopted the euro on 2026-01-01)",
      "ANG retired, successor XCG; XCG (Caribbean Guilder) added",
      "ZWL retired, successor ZWG; ZWG (Zimbabwe Gold) added"
    ],
    "fields": {
      "code": "the ISO 4217 alphabetic code",
      "name": "the currency's English name as the list gives it",
      "minor_units": "the exponent: digits after the decimal point in the currency's minor unit; null when the list gives N.A.",
      "status": "active (in List One) or retired (in List Three only)",
      "successor": "the code that replaced a retired currency; null for an active one. A successor says which currency replaced it, never at what rate."
    }
  },
  "review": {
    "status": "transcribed and cross-checked locally: verify against the current List One and List Three before a production run reads any entry the tests do not pin",
    "open_questions": [
      "SLL and CUC are kept active, as the cross-check source lists them; confirm whether List One still carries them",
      "confirm the entries under after_cross_check against the Maintenance Agency's amendments"
    ],
    "pinned_by": "tests/test_economics_engine.py pins JPY 0, USD 2, KWD 3, the retired HRK, GRD and PTE and their successor, and the digest of the whole document (the entries and these source and review records): any edit to it fails the test until the pin moves in the same reviewed change"
  },
